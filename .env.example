AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.7-flash
AI_GATEWAY_AUTHOR_MODEL=openai/gpt-5.6-sol-fast
AI_GATEWAY_REVIEW_MODEL=anthropic/claude-sonnet-5
AI_GATEWAY_REHEARSAL_ROLE_MODEL=google/gemini-3.7-flash
AI_GATEWAY_REHEARSAL_HOST_MODEL=google/gemini-3.7-flash
AI_GATEWAY_REHEARSAL_JUDGE_MODEL=anthropic/claude-sonnet-5
# Local PostgreSQL; replace with the pooled Neon DATABASE_URL in production.
DATABASE_URL=postgresql://localhost/le_carnet_bleu_dev
# Durable workflow state in local development. Vercel selects Vercel World in production.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgresql://localhost/le_carnet_bleu_dev
WORKFLOW_LOCAL_BASE_URL=http://localhost:3000
